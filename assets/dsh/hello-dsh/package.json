{
  "name": "hello-dsh",
  "version": "0.1.0",
  "description": "Hello.'s layer over DeepSeek Harness: the Hello theme (every dsh token from Hello's own), Hello's Inter, and Hello's mark in dsh's brand slots.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib/", "cordis.patch.yml", "official-tokens.json"],
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "theme", "hello"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-theme", "@deepseek-ai/dsh-client-ui-renderer"] }
  }
}
